# Anthropic — https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# Voyage AI — https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=

# Pinecone — https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_NAME=melodymatch

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius — https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Clerk — https://dashboard.clerk.com → API Keys
# JWKS URL: API Keys → Advanced → JWT Verification Key (JWKS URL)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
# Webhooks → Add Endpoint → copy signing secret
CLERK_WEBHOOK_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhooks → Add Endpoint → copy signing secret
STRIPE_WEBHOOK_SECRET=
# Products → each product → Pricing section → copy the price_xxx ID (NOT the prod_xxx ID)
STRIPE_EXPLORER_PRICE_ID=
STRIPE_UNLIMITED_PRICE_ID=

# Supabase — https://supabase.com/dashboard → your project → Settings → API
# Do NOT include /rest/v1/ — use the bare project URL
SUPABASE_URL=
# Use the service_role key (not the anon key)
SUPABASE_SERVICE_KEY=

# CORS — set to your Vercel URL in production
FRONTEND_URL=http://localhost:3000

# Dev mode — set to true for local testing to bypass ALL paid-tier gating:
# unlimited searches (no monthly quota), full catalog for everyone, and usage
# counters are not incremented. Leave unset/false in production.
DEV_MODE=false
